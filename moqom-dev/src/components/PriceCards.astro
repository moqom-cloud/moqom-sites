---
/**
 * Copied from sites/_shared/pricing/PriceCards.astro — the canonical copy lives in sites/_shared.
 * Edit there, then re-copy. This copy imports from src/data/price-cards and is restyled with
 * Starlight's theme variables instead of glass.css, so it reads in both light and dark mode.
 *
 * Price comparison cards: a grid on wide screens, a swipeable scroll-snap row on phones.
 * No client JS.
 */
import { PRICE_CARDS, KEY_POINTS, PRICE_FOOTNOTE } from '../data/price-cards';

interface Props {
  heading?: string;
  showKeyPoints?: boolean;
}
const { heading = 'Usually much cheaper. Faster, and end-to-end encrypted in every room.', showKeyPoints = true } = Astro.props;
---

<section class="pc not-content" aria-labelledby="pc-heading">
  <h2 id="pc-heading" class="pc-heading">{heading}</h2>
  <p class="pc-sub">Real scenarios, per hour, against Agora’s list price.</p>

  <ul class="pc-track" role="list" aria-label="Price comparisons; swipe for more">
    {PRICE_CARDS.map((c) => (
      <li class:list={['pc-card', c.highlight && 'is-highlight']}>
        <p class="pc-saving">{c.saving}</p>
        <h3 class="pc-title">{c.title}</h3>
        <p class="pc-scenario">{c.scenario}</p>
        <dl class="pc-prices">
          <div><dt>Agora</dt><dd class="pc-agora">{c.agora}</dd></div>
          <div><dt>MOQOM</dt><dd class="pc-moqom">{c.moqom}</dd></div>
        </dl>
        {c.note && <p class="pc-note">{c.note}</p>}
      </li>
    ))}
  </ul>

  {showKeyPoints && (
    <ul class="pc-points" role="list">
      {KEY_POINTS.map((k) => (
        <li>
          <h3>{k.title}</h3>
          <p>{k.body}</p>
        </li>
      ))}
    </ul>
  )}

  <p class="pc-foot">{PRICE_FOOTNOTE}</p>
</section>

<style>
  .pc { --pc-gap: 1rem; margin-block: 2rem; }
  .pc-heading { font-size: var(--sl-text-h2); line-height: var(--sl-line-height-headings); color: var(--sl-color-white); margin: 0 0 0.4em; }
  .pc-sub { color: var(--sl-color-gray-3); margin: 0 0 1.25rem; }

  .pc-track {
    list-style: none;
    margin: 0;
    padding: 0.25rem 0 1rem;
    display: grid;
    gap: var(--pc-gap);
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  }

  /* Phones: one swipeable row, cards snap to the start edge. */
  @media (max-width: 720px) {
    .pc-track {
      grid-auto-flow: column;
      grid-template-columns: none;
      grid-auto-columns: 82%;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }
    .pc-track::-webkit-scrollbar { display: none; }
    .pc-card { scroll-snap-align: start; }
  }

  .pc-card,
  .pc-points li {
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 0.75rem;
    background: var(--sl-color-gray-6);
  }
  .pc-card { padding: 1.2rem 1.2rem 1rem; display: flex; flex-direction: column; gap: 0.45rem; min-height: 14rem; }
  .pc-card.is-highlight { border-color: var(--sl-color-accent); }
  .pc-saving {
    margin: 0;
    font-size: 1.8rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--sl-color-accent);
  }
  .pc-title { margin: 0; font-size: 1rem; color: var(--sl-color-white); }
  .pc-scenario { margin: 0; color: var(--sl-color-gray-2); font-size: 0.875rem; flex: 1; }
  .pc-prices { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; margin: 0.4rem 0 0; }
  .pc-prices dt { font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--sl-color-gray-3); }
  .pc-prices dd { margin: 0; font-variant-numeric: tabular-nums; font-size: 1.1rem; color: var(--sl-color-white); }
  .pc-agora { color: var(--sl-color-gray-3); text-decoration: line-through; }
  .pc-moqom { font-weight: 700; }
  .pc-note { margin: 0.2rem 0 0; font-size: 0.78rem; color: var(--sl-color-gray-3); }

  .pc-points {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    display: grid;
    gap: var(--pc-gap);
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  }
  .pc-points li { padding: 1rem 1.1rem; }
  .pc-points h3 { margin: 0 0 0.35rem; font-size: 0.95rem; color: var(--sl-color-white); }
  .pc-points p { margin: 0; color: var(--sl-color-gray-2); font-size: 0.875rem; }

  .pc-foot { margin: 1.25rem 0 0; font-size: 0.75rem; color: var(--sl-color-gray-3); max-width: 70ch; }
</style>
