---
// Plain code block with a copy button. No syntax highlighting: highlighters emit inline style
// attributes, which the site's CSP check rejects.
interface Props {
  code: string;
  title?: string;
}
const { code, title } = Astro.props;
---

<div class="code">
  <div class="code-head">
    <span>{title ?? ''}</span>
    <button type="button" class="copy" data-copy>Copy</button>
  </div>
  <pre><code>{code}</code></pre>
</div>

<style>
  .code {
    margin: 1rem 0 1.5rem;
    max-width: 100%;
  }
  .code-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    font: 0.72rem var(--font-mono);
    color: var(--text-faint);
    padding: 0 0.25rem 0.35rem;
  }
  .copy {
    font: 0.72rem var(--font-mono);
    color: var(--text-dim);
    background: transparent;
    border: 1px solid var(--line-strong);
    border-radius: 6px;
    padding: 0.2em 0.6em;
    cursor: pointer;
  }
  .copy:hover {
    color: var(--amber);
    border-color: var(--amber);
  }
</style>
