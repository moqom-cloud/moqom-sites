---
/**
 * Generative Elliott-wave motif: a five-wave impulse followed by a three-wave
 * correction, drawn as a ribbon of strands. Computed at build time; no client JS.
 */
interface Props {
  strands?: number;
  accent?: string;
  labels?: boolean;
  height?: number;
  class?: string;
}

const { strands = 18, accent = 'var(--accent)', labels = false, height = 520, class: cls = '' } = Astro.props;

const W = 1200;
const H = height;

// Pivots of the 5-3 pattern: x as a fraction of width, y as a fraction of height (0 = bottom).
const pivots: Array<[number, number, string]> = [
  [0.0, 0.16, ''],
  [0.11, 0.42, '1'],
  [0.19, 0.29, '2'],
  [0.4, 0.76, '3'],
  [0.49, 0.58, '4'],
  [0.66, 0.9, '5'],
  [0.76, 0.64, 'A'],
  [0.84, 0.77, 'B'],
  [1.0, 0.44, 'C'],
];

type Pt = [number, number];

function catmullRom(pts: Pt[]): string {
  const f = (n: number) => n.toFixed(1);
  let d = `M${f(pts[0][0])},${f(pts[0][1])}`;
  for (let i = 0; i < pts.length - 1; i++) {
    const p0 = pts[i - 1] ?? pts[i];
    const p1 = pts[i];
    const p2 = pts[i + 1];
    const p3 = pts[i + 2] ?? p2;
    const c1: Pt = [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6];
    const c2: Pt = [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6];
    d += ` C${f(c1[0])},${f(c1[1])} ${f(c2[0])},${f(c2[1])} ${f(p2[0])},${f(p2[1])}`;
  }
  return d;
}

const padY = H * 0.08;
const toPt = (x: number, y: number): Pt => [x * W, H - padY - y * (H - padY * 2)];

const strandPaths = Array.from({ length: strands }, (_, k) => {
  const t = k / Math.max(1, strands - 1);
  const amp = 0.62 + t * 0.38;
  const lift = (1 - t) * 0.1;
  const pts = pivots.map(([x, y], i) => {
    const wobble = Math.sin(i * 1.9 + k * 0.7) * 0.012 * (1 - t);
    return toPt(x, lift + y * amp + wobble);
  });
  return { d: catmullRom(pts), opacity: 0.08 + t * 0.32, delay: (k * 60) / 1000 };
});

const main = pivots.map(([x, y]) => toPt(x, y));
const mainPath = catmullRom(main);
---

<svg
  class:list={['wave', cls]}
  viewBox={`0 0 ${W} ${H}`}
  preserveAspectRatio="xMidYMid slice"
  role="img"
  aria-label="An Elliott wave: five waves up, three waves of correction"
  style={`--wave-accent: ${accent}`}
>
  <defs>
    <linearGradient id="wave-fade" x1="0" x2="1" y1="0" y2="0">
      <stop offset="0" stop-color="currentColor" stop-opacity="0" />
      <stop offset="0.18" stop-color="currentColor" stop-opacity="1" />
      <stop offset="0.85" stop-color="currentColor" stop-opacity="1" />
      <stop offset="1" stop-color="currentColor" stop-opacity="0" />
    </linearGradient>
  </defs>
  <g class="field" stroke="url(#wave-fade)" fill="none">
    {strandPaths.map((s) => (
      <path d={s.d} pathLength="1" stroke-width="1" style={`opacity:${s.opacity};animation-delay:${s.delay}s`} class="strand" />
    ))}
  </g>
  <path d={mainPath} pathLength="1" class="strand main" fill="none" stroke="var(--wave-accent)" stroke-width="2" />
  {labels && (
    <g class="pivots">
      {pivots.map(([, , label], i) =>
        label ? (
          <g transform={`translate(${main[i][0].toFixed(1)} ${main[i][1].toFixed(1)})`} style={`animation-delay:${0.6 + i * 0.12}s`}>
            <circle r="3.5" fill="var(--wave-accent)" />
            <text y={i % 2 === 1 ? -14 : 24} text-anchor="middle">{label}</text>
          </g>
        ) : null
      )}
    </g>
  )}
</svg>

<style>
  .wave {
    display: block;
    width: 100%;
    height: auto;
    color: var(--text-dim);
    overflow: visible;
  }
  .strand {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw 2.6s cubic-bezier(0.65, 0, 0.35, 1) forwards;
  }
  .strand.main {
    animation-duration: 3.2s;
    filter: drop-shadow(0 0 10px color-mix(in srgb, var(--wave-accent) 45%, transparent));
  }
  .field {
    animation: drift 22s ease-in-out infinite alternate;
    transform-origin: center;
  }
  .pivots g {
    opacity: 0;
    animation: appear 0.6s ease forwards;
  }
  .pivots text {
    font-family: var(--font-mono);
    font-size: 13px;
    fill: var(--text-dim);
    letter-spacing: 0.08em;
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes drift {
    from {
      transform: translateY(-6px) scaleY(0.98);
    }
    to {
      transform: translateY(6px) scaleY(1.02);
    }
  }
  @keyframes appear {
    to {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .strand,
    .field {
      animation: none;
      stroke-dashoffset: 0;
    }
    .pivots g {
      animation: none;
      opacity: 1;
    }
  }
</style>
