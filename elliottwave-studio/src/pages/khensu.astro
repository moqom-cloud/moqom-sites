---
import { APP_STORE_ID, APP_STORE_URL, GOOGLE_PLAY_ID, GOOGLE_PLAY_URL } from '../data/app';
import Base from '../layouts/Base.astro';
import Hero from '../components/khensu/Hero.astro';
import Sections from '../components/khensu/Sections.astro';
import StatStrip from '../components/khensu/StatStrip.astro';
---

<Base
  title="khensu.ñü"
  description="khensu.ñü is a post-quantum private messenger on a network run by people: messages, calls, feeds, forums, sites and private payments, with private AI that runs only on your device."
>
  <Hero eyebrow="elliottwave.studio lab · Flagship 00000000" cta={false} />

  <section class="home-stats" aria-label="khėnsu.ñü in numbers">
    <div class="wrap">
      <StatStrip
        items={[
          { n: 5, label: 'Mix network hops for every message' },
          { n: 0, label: 'Servers that read or process your data' },
          { n: 10, unit: '%', label: 'Flat app fee, the lowest in the industry' },
          { n: 100, unit: '%', label: 'Of every view and tip, gift or payment goes to the person' },
        ]}
      >
        ñü takes no commission on tips, gifts or views: every cent goes to the person. See the <a href="https://network.khensu.nu#network-economics">network economics</a> and <a href="https://fi.khensu.nu">nufi</a>.
      </StatStrip>
    </div>
  </section>

  <div class="khensu">
    <Sections show={['intro', 'highlights', 'creators', 'creatorpay', 'pay', 'economics', 'explore', 'numedia', 'perankh', 'cta', 'ringcode', 'design']} />
  </div>
</Base>

<style>
  .home-stats {
    position: relative;
    z-index: 1;
    padding: clamp(1rem, 3vw, 2rem) 0 clamp(3rem, 7vw, 5rem);
  }
  .home-stats :global(.stat-strip) {
    margin: 0;
  }
</style>
