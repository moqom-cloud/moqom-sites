---
import { CAREER, FIELDS, FIRST_YEAR, LINKS, NOW, STATS, at, yearsByField, type Field } from '../data/career';

const lastYear = Number(NOW.slice(0, 4));
const ticks = Array.from({ length: Math.floor((lastYear - FIRST_YEAR) / 2) + 1 }, (_, i) => FIRST_YEAR + i * 2);
const pct = (n: number) => `${(n * 100).toFixed(2)}%`;

const byField = yearsByField().sort((a, b) => b.years - a.years);
const maxYears = Math.max(...byField.map((f) => f.years));

const span = (c: (typeof CAREER)[number]) => {
  const start = c.roles[0].start.slice(0, 4);
  const last = c.roles[c.roles.length - 1].end;
  const end = last === null ? 'now' : last.slice(0, 4);
  return start === end ? start : `${start}–${end}`;
};
const rows = [...CAREER].reverse();
---

<section class="section career" aria-labelledby="career-head">
  <div class="wrap">
    <p class="eyebrow">Portfolio</p>
    <h2 id="career-head">Twenty years, one through-line: keep it secure, make it feel effortless.</h2>
    <p class="lede">
      It started with paid programming in his early teens, then newsletters and magazines at 15. Film studios trusted him with their archives, and the platform was never breached. Startups trusted him with their
      first line of code, and a few with their whole company.
    </p>

    <dl class="stats">
      {STATS.map((s) => (
        <div>
          <dt>{s.label}</dt>
          <dd>{s.value}</dd>
        </div>
      ))}
    </dl>

    <figure class="timeline" aria-label={`Career timeline, ${FIRST_YEAR} to now`}>
      <figcaption>
        <h3>Timeline</h3>
        <ul class="legend">
          {(Object.keys(FIELDS) as Field[]).map((f) => (
            <li><i style={`--c:${FIELDS[f].color}`}></i>{FIELDS[f].label}</li>
          ))}
        </ul>
      </figcaption>
      <div class="axis" aria-hidden="true">
        {ticks.map((y) => <span style={`left:${pct(at(`${y}-01`))}`}>{y}</span>)}
      </div>
      <ol class="rows">
        {rows.map((c, i) => (
          <li style={`--c:${FIELDS[c.field].color}; --i:${i}`}>
            <div class="who">
              {c.url ? <a href={c.url} rel={c.url.startsWith('http') ? 'noopener' : undefined}>{c.name}</a> : <span>{c.name}</span>}
              <span class="when">{span(c)}</span>
            </div>
            <div class="track">
              {ticks.map((y) => <i class="grid" style={`left:${pct(at(`${y}-01`))}`} aria-hidden="true"></i>)}
              {c.roles.map((r) => (
                <span
                  class:list={['bar', { live: r.end === null }]}
                  style={`left:${pct(at(r.start))}; width:max(4px, ${pct(at(r.end ?? NOW) - at(r.start))})`}
                  title={`${r.title} · ${r.start.replace('-', '/')} – ${r.end ? r.end.replace('-', '/') : 'now'}`}
                ></span>
              ))}
            </div>
          </li>
        ))}
      </ol>
    </figure>

    <ul class="cards">
      {rows.map((c) => (
        <li style={`--c:${FIELDS[c.field].color}`}>
          <p class="card-head">
            {c.url ? <a href={c.url} rel={c.url.startsWith('http') ? 'noopener' : undefined}>{c.name}</a> : <span>{c.name}</span>}
            <span class="when">{span(c)}</span>
          </p>
          <p class="role">{c.roles.map((r) => r.title).join(' → ')}</p>
          <p class="note">{c.note}</p>
        </li>
      ))}
    </ul>

    <div class="split">
      <figure class="fields">
        <figcaption><h3>Years in each field</h3><p>Overlapping roles counted once.</p></figcaption>
        <ul>
          {byField.map((f, i) => (
            <li style={`--c:${FIELDS[f.field].color}; --w:${(f.years / maxYears).toFixed(3)}; --i:${i}`}>
              <span class="label">{FIELDS[f.field].label}</span>
              <span class="meter"><span></span></span>
              <span class="num">{f.years.toFixed(1)}</span>
            </li>
          ))}
        </ul>
      </figure>

      <div class="links">
        <h3>Elsewhere</h3>
        <ul>
          {LINKS.map((l) => (
            <li>
              <a href={l.href} rel="noopener">
                <span class="name">{l.label}</span>
                <span class="detail">{l.detail}</span>
                <span class="arrow" aria-hidden="true">↗</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
    <p class="source">From LinkedIn, plus Favorited, Varasa and the lab. Past work only: none of these companies used MOQOM.</p>
  </div>
</section>

<style>
  .career h2 {
    max-width: 22ch;
  }
  .lede {
    max-width: var(--measure);
    color: var(--text-dim);
  }
  h3 {
    font-size: 1rem;
    margin: 0;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    margin: 2.5rem 0 3rem;
  }
  @media (min-width: 900px) {
    .stats {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .stats > div {
    display: flex;
    flex-direction: column;
    padding: 1.4rem 1.5rem;
    background: var(--bg-raised);
  }
  .stats dt {
    order: 2;
    font-size: 0.85rem;
    color: var(--text-dim);
  }
  .stats dd {
    order: 1;
    margin: 0 0 0.35rem;
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 3.4vw, 2.6rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--accent);
  }

  .timeline {
    margin: 0;
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-raised);
    --label: 13rem;
  }
  .timeline figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    margin-bottom: 1.25rem;
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.1rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.78rem;
    color: var(--text-dim);
  }
  .legend i {
    display: inline-block;
    width: 0.6rem;
    height: 0.6rem;
    margin-right: 0.4rem;
    border-radius: 2px;
    background: var(--c);
  }
  .axis {
    position: relative;
    height: 1.2rem;
    margin-left: var(--label);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-faint);
  }
  .axis span {
    position: absolute;
    transform: translateX(-50%);
  }
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .rows li {
    display: grid;
    grid-template-columns: var(--label) 1fr;
    align-items: center;
    border-top: 1px solid var(--line);
  }
  .who {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.35rem 1rem 0.35rem 0;
    font-size: 0.88rem;
    line-height: 1.3;
  }
  .who a {
    color: var(--text);
    text-decoration-color: var(--line-strong);
  }
  .who a:hover {
    color: var(--c);
  }
  .when {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-faint);
  }
  .track {
    position: relative;
    height: 100%;
    min-height: 1.9rem;
  }
  .grid {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--line);
    opacity: 0.6;
  }
  .bar {
    position: absolute;
    top: 50%;
    height: 0.7rem;
    margin-top: -0.35rem;
    border-radius: 999px;
    background: var(--c);
    box-shadow: 0 0 14px color-mix(in srgb, var(--c) 45%, transparent);
    transform-origin: left center;
    animation: grow 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: calc(var(--i) * 45ms);
  }
  .bar.live {
    background: linear-gradient(90deg, var(--c), color-mix(in srgb, var(--c) 40%, white));
    background-size: 200% 100%;
    animation: grow 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both, shimmer 3s linear infinite;
    animation-delay: calc(var(--i) * 45ms), 0s;
  }
  .cards {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: 0.75rem;
  }
  .cards li {
    padding: 1rem 1.1rem 1.1rem;
    border: 1px solid var(--line);
    border-top: 2px solid var(--c);
    border-radius: 10px;
    background: var(--bg-raised);
  }
  .cards p {
    margin: 0;
  }
  .card-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
    font-weight: 500;
  }
  .card-head a {
    color: var(--text);
    text-decoration-color: var(--line-strong);
  }
  .card-head a:hover {
    color: var(--c);
  }
  .role {
    margin-top: 0.2rem !important;
    font-size: 0.8rem;
    color: var(--c);
  }
  .note {
    margin-top: 0.5rem !important;
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--text-dim);
  }
  @keyframes grow {
    from {
      transform: scaleX(0);
      opacity: 0;
    }
  }
  @keyframes shimmer {
    to {
      background-position: -200% 0;
    }
  }

  .split {
    display: grid;
    gap: 2rem 3rem;
    margin-top: 3rem;
  }
  @media (min-width: 900px) {
    .split {
      grid-template-columns: 1.2fr 1fr;
    }
  }
  .fields {
    margin: 0;
  }
  .fields figcaption p {
    margin: 0.2rem 0 1rem;
    font-size: 0.8rem;
    color: var(--text-faint);
  }
  .fields ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.7rem;
  }
  .fields li {
    display: grid;
    grid-template-columns: 11rem 1fr 2.5rem;
    align-items: center;
    gap: 0.9rem;
    font-size: 0.85rem;
  }
  .meter {
    height: 0.6rem;
    border-radius: 999px;
    background: var(--line);
    overflow: hidden;
  }
  .meter span {
    display: block;
    height: 100%;
    width: calc(var(--w) * 100%);
    border-radius: inherit;
    background: var(--c);
    transform-origin: left center;
    animation: grow 1.1s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: calc(0.3s + var(--i) * 90ms);
  }
  .num {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-dim);
    text-align: right;
  }

  .links ul {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
    gap: 0.6rem;
  }
  .links a {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 0.8rem 2.2rem 0.8rem 1rem;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--bg-raised);
    text-decoration: none;
    color: var(--text);
    transition: border-color 0.2s, transform 0.2s;
  }
  .links a:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .links .detail {
    font-size: 0.78rem;
    color: var(--text-faint);
  }
  .links .arrow {
    position: absolute;
    top: 0.8rem;
    right: 0.9rem;
    color: var(--text-faint);
  }
  .links a:hover .arrow {
    color: var(--accent);
  }
  .source {
    margin-top: 2rem;
    font-size: 0.78rem;
    color: var(--text-faint);
  }

  @media (max-width: 640px) {
    .timeline {
      padding: 1rem;
      --label: 7.5rem;
    }
    .fields li {
      grid-template-columns: 8rem 1fr 2.2rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .bar,
    .bar.live,
    .meter span {
      animation: none;
    }
  }
</style>
