# Base URL of the MOQOM billing API. The signup form POSTs to ${PUBLIC_BILLING_API}/v1/signup.
# Read once, in src/data/site.ts (SIGNUP.apiBase). The load balancer serves it at moqom.cloud/v1/*.
PUBLIC_BILLING_API=https://moqom.cloud

# The signup form renders unless this is exactly "false".
PUBLIC_SIGNUP_ENABLED=true
