---
import Base from "./Base.astro";

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---

<Base title={title} description={description} noindex>
  <section class="section">
    <article class="narrow glass card legal">
      <div class="draft" role="note">
        <strong>DRAFT.</strong> This is a placeholder and not a binding agreement. We have contacted legal counsel to
        review this. It will be replaced before MOQOM Cloud accepts payment.
      </div>
      <h1>{title}</h1>
      <p class="faint small">Elliott Wave LLC · Last updated: draft, October 2026</p>
      <slot />
    </article>
  </section>
</Base>

<style>
  .draft {
    border: 2px dashed var(--warn);
    background: rgb(251 191 36 / 0.08);
    color: var(--warn);
    border-radius: var(--radius);
    padding: var(--space-4) var(--space-5);
    margin-bottom: var(--space-6);
    font-size: var(--text-sm);
  }
  .legal :global(h2) {
    font-size: var(--text-xl);
    margin-top: var(--space-6);
  }
  .legal :global(p),
  .legal :global(li) {
    color: var(--text-muted);
  }
</style>
