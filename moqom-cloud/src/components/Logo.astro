---
interface Props {
  size?: number;
}
const { size = 26 } = Astro.props;
const id = `lg-${Math.random().toString(36).slice(2, 8)}`;
---

<svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id={id} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#22D3EE" />
      <stop offset="1" stop-color="#8B5CF6" />
    </linearGradient>
  </defs>
  <rect x="1" y="1" width="30" height="30" rx="8" fill="#111317" stroke="#23272F" />
  <circle cx="9" cy="16" r="3" fill={`url(#${id})`} />
  <path d="M12 16h5" stroke={`url(#${id})`} stroke-width="2" stroke-linecap="round" />
  <circle cx="19.5" cy="16" r="2.5" fill="none" stroke={`url(#${id})`} stroke-width="2" />
  <path d="M22 16l4-6M22 16h4.5M22 16l4 6" stroke={`url(#${id})`} stroke-width="2" stroke-linecap="round" />
</svg>
