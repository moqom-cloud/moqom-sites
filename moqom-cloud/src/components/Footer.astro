---
import Logo from "./Logo.astro";
import { BENCH_FOOTNOTE, COPYRIGHT, SITE } from "../data/site";
---

<footer class="site-footer">
  <div class="container glass panel">
    <div class="cols">
      <div class="about">
        <a href="/" class="brand" aria-label="MOQOM Cloud home"><Logo size={22} /> MOQOM Cloud</a>
        <p class="small faint">MOQOM · Media Over QUIC Orchestration Mesh</p>
        <p class="small muted">
          Real-time video on Media over QUIC. Built by{" "}
          <a class="parent" href={SITE.parent} rel="noopener">{SITE.parentName}</a>.
        </p>
      </div>
      <div>
        <h2 class="col-head">Product</h2>
        <ul>
          <li><a href="/benchmarks/">Benchmarks</a></li>
          <li><a href="/compare/">Compare</a></li>
          <li><a href="/migrate/">Migrate from Agora</a></li>
          <li><a href="/security/">Security</a></li>
          <li><a href="/compliance/">Compliance</a></li>
          <li><a href="/platforms/">Platforms</a></li>
          <li><a href="/pricing/">Pricing</a></li>
          <li><a href="/signup/">Sign up</a></li>
        </ul>
      </div>
      <div>
        <h2 class="col-head">Developers</h2>
        <ul>
          <li><a href={SITE.docs} rel="noopener">Documentation ↗</a></li>
          <li><a href={`${SITE.docs}/specs/methodology/`} rel="noopener">Benchmark methodology ↗</a></li>
          <li><a href="/pricing/#api">Billing API</a></li>
          <li><a href="https://elliottwave.dev/status" rel="noopener">Platform status ↗</a></li>
          <li><a href={SITE.contribute} rel="noopener">Contribute ↗</a></li>
          <li><a href={SITE.donate} rel="noopener">Donate ↗</a></li>
        </ul>
      </div>
      <div>
        <h2 class="col-head">Company</h2>
        <ul>
          <li><a href="/company/">About</a></li>
          <li><a href="/press/">Press</a></li>
          <li><a href={SITE.parent} rel="noopener">{SITE.parentName} ↗</a></li>
          <li><a href="/legal/terms/">Terms</a></li>
          <li><a href="/legal/notices/">Legal notices</a></li>
          <li><a href="/legal/privacy/">Privacy</a></li>
        </ul>
      </div>
    </div>
    <div class="legal">
      <p class="small faint">{COPYRIGHT}</p>
      <p class="small faint">{BENCH_FOOTNOTE} Not production SLAs.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--space-6);
    margin-top: var(--space-8);
  }
  .panel {
    padding: var(--space-6);
  }
  .panel > * {
    position: relative;
    z-index: 2;
  }
  .cols {
    display: grid;
    grid-template-columns: 2fr repeat(3, 1fr);
    gap: var(--space-6);
  }
  @media (max-width: 760px) {
    .panel {
      padding: var(--space-5);
    }
    .cols {
      grid-template-columns: 1fr 1fr;
    }
    .about {
      grid-column: 1 / -1;
    }
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--text);
    font-weight: 700;
    margin-bottom: var(--space-3);
  }
  .parent {
    color: var(--parent);
  }
  .col-head {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-faint);
    margin-bottom: var(--space-3);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    margin-bottom: var(--space-2);
  }
  li a {
    color: var(--text-muted);
    font-size: var(--text-sm);
  }
  li a:hover {
    color: var(--text);
  }
  .legal {
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid var(--glass-edge);
  }
  .legal p {
    margin-bottom: var(--space-2);
  }
</style>
