---
import Logo from "./Logo.astro";
import { NAV } from "../data/site";

const path = Astro.url.pathname;
---

<header class="site-header glass glass--strong glass-bar">
  <div class="bar">
    <a href="/" class="brand" aria-label="MOQOM Cloud home">
      <Logo />
      <span class="wordmark">MOQOM<span class="faint"> Cloud</span></span>
    </a>
    <nav aria-label="Primary">
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={!item.external && path.startsWith(item.href) ? "page" : undefined}
                {...(item.external ? { rel: "noopener" } : {})}
              >
                {item.label}
                {item.external && <span aria-hidden="true"> ↗</span>}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a class="btn btn-primary cta" href="/signup/">Get an API key</a>
  </div>
</header>

<style>
  .site-header {
    width: min(100% - 2 * var(--space-4), var(--container));
    margin-top: var(--space-3);
  }
  .bar {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: var(--space-5);
    min-height: 56px;
    padding-inline: var(--space-5) var(--space-2);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--text);
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  .brand:hover {
    text-decoration: none;
  }
  nav {
    margin-left: auto;
  }
  ul {
    display: flex;
    gap: var(--space-1);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    display: inline-block;
    padding: var(--space-2) var(--space-3);
    color: var(--text-muted);
    font-size: var(--text-sm);
    border-radius: var(--radius-pill);
    white-space: nowrap;
  }
  nav a:hover,
  nav a[aria-current="page"] {
    color: var(--text);
    text-decoration: none;
  }
  nav a[aria-current="page"] {
    background: rgb(255 255 255 / 0.09);
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.1) inset;
  }
  .cta {
    min-height: 40px;
  }
  @media (max-width: 820px) {
    .site-header {
      border-radius: var(--glass-radius);
    }
    .bar {
      flex-wrap: wrap;
      gap: var(--space-2);
      padding: var(--space-2) var(--space-2) var(--space-1) var(--space-4);
    }
    .cta {
      margin-left: auto;
    }
    nav {
      order: 3;
      width: 100%;
      margin-left: 0;
      overflow-x: auto;
      scrollbar-width: none;
    }
    nav::-webkit-scrollbar {
      display: none;
    }
    nav a {
      padding-inline: var(--space-2);
    }
  }
</style>
