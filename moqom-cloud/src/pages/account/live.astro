---
// Not the shared Base layout: Base adds the analytics tag when PUBLIC_GA_ID is set, and this page
// holds a pasted API key and shows where a tenant's users are. It runs no third-party script.
import "@fontsource-variable/inter";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/600.css";
import "../../styles/global.css";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import LiveMap from "../../components/LiveMap.astro";
import { SITE } from "../../data/site";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Live connections · {SITE.name}</title>
    <meta name="description" content="Where your MOQOM Cloud sessions are connected from right now, in anonymous counts per place." />
    <meta name="robots" content="noindex" />
    <meta name="referrer" content="no-referrer" />
    <meta name="theme-color" content="#0A0B0D" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <div class="glass-field" aria-hidden="true"></div>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <LiveMap />
    </main>
    <Footer />
  </body>
</html>
