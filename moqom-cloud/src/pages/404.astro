---
import Base from "../layouts/Base.astro";
---

<Base title="Not found" noindex>
  <section class="section">
    <div class="narrow">
      <span class="eyebrow">404</span>
      <h1>This page dropped its subgroup.</h1>
      <p class="lede">The page you asked for isn't here.</p>
      <div class="btn-row">
        <a class="btn btn-primary" href="/">Home</a>
        <a class="btn" href="https://moqom.dev" rel="noopener">Docs ↗</a>
      </div>
    </div>
  </section>
</Base>
